{
  "name": "tool-hub-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:prettier": "prettier --check .",
    "fix:prettier": "npm run lint:prettier -- --write"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.0.5",
    "@radix-ui/react-dropdown-menu": "2.0.6",
    "@radix-ui/react-label": "2.0.2",
    "@radix-ui/react-popover": "1.0.7",
    "@radix-ui/react-slot": "1.0.2",
    "@radix-ui/react-switch": "1.0.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "cmdk": "0.2.1",
    "lucide-react": "0.378.0",
    "next": "15.5.26",
    "next-themes": "0.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.3.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@types/node": "20.12.8",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "prettier": "3.2.5",
    "tailwindcss": "3.4.3",
    "typescript": "5.4.5"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "arrowParens": "always",
    "printWidth": 80,
    "bracketSpacing": true,
    "plugins": [],
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "printWidth": 360
        }
      },
      {
        "files": [
          "*.css",
          "*.scss"
        ],
        "options": {
          "singleQuote": false
        }
      }
    ]
  },
  "packageManager": "npm@12.1.0",
  "overrides": {
    "@babel/runtime": "7.29.7",
    "ajv": "8.20.0",
    "brace-expansion": "2.1.7",
    "braces": "3.0.3",
    "cross-spawn": "7.0.6",
    "flatted": "3.4.4",
    "glob": "13.0.6",
    "js-yaml": "4.3.2",
    "micromatch": "4.0.8",
    "minimatch": "5.1.9",
    "nanoid": "3.3.19",
    "picomatch": "2.3.2",
    "yaml": "2.9.1",
    "next": {
      "postcss": "8.5.28"
    }
  }
}
